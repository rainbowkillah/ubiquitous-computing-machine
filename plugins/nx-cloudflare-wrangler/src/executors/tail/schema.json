{
  "$schema": "https://json-schema.org/schema",
  "version": 2,
  "title": "Tail executor",
  "description": "Tail logs with wrangler",
  "type": "object",
  "properties": {
    "config": {
      "type": "string",
      "description": "Path to wrangler config file"
    },
    "env": {
      "type": "string",
      "description": "Environment to tail"
    },
    "format": {
      "type": "string",
      "description": "Log format (json or pretty)",
      "enum": ["json", "pretty"]
    },
    "status": {
      "type": "string",
      "description": "Filter by status",
      "enum": ["ok", "error", "canceled"]
    },
    "extraArgs": {
      "type": "array",
      "description": "Additional arguments to pass to wrangler tail",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": []
}
