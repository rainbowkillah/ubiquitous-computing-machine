{
  "$schema": "https://json-schema.org/schema",
  "version": 2,
  "title": "Dev executor",
  "description": "Run wrangler dev",
  "type": "object",
  "properties": {
    "config": {
      "type": "string",
      "description": "Path to wrangler config file (wrangler.jsonc or wrangler.toml)"
    },
    "env": {
      "type": "string",
      "description": "Environment to use (dev/stage/prod)"
    },
    "port": {
      "type": "number",
      "description": "Port to listen on"
    },
    "ip": {
      "type": "string",
      "description": "IP address to listen on"
    },
    "local": {
      "type": "boolean",
      "description": "Run locally (without connecting to Cloudflare)",
      "default": false
    },
    "persist": {
      "type": "boolean",
      "description": "Enable persistence for local mode",
      "default": false
    },
    "remote": {
      "type": "boolean",
      "description": "Develop against remote resources",
      "default": false
    },
    "verbose": {
      "type": "boolean",
      "description": "Enable verbose logging",
      "default": false
    },
    "extraArgs": {
      "type": "array",
      "description": "Additional arguments to pass to wrangler dev",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": []
}
