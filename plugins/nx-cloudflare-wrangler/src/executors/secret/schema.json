{
  "$schema": "https://json-schema.org/schema",
  "version": 2,
  "title": "Secret executor",
  "description": "Manage secrets with wrangler",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "description": "Action to perform (put, delete, list)",
      "enum": ["put", "delete", "list"],
      "default": "list"
    },
    "name": {
      "type": "string",
      "description": "Name of the secret"
    },
    "value": {
      "type": "string",
      "description": "Value of the secret (for put action)"
    },
    "config": {
      "type": "string",
      "description": "Path to wrangler config file"
    },
    "env": {
      "type": "string",
      "description": "Environment to manage secrets for"
    },
    "extraArgs": {
      "type": "array",
      "description": "Additional arguments to pass to wrangler secret",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": []
}
