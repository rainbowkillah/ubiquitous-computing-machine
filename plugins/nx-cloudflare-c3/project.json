{
  "name": "nx-cloudflare-c3",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "plugins/nx-cloudflare-c3/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/plugins/nx-cloudflare-c3",
        "main": "plugins/nx-cloudflare-c3/src/index.ts",
        "tsConfig": "plugins/nx-cloudflare-c3/tsconfig.lib.json",
        "assets": [
          "plugins/nx-cloudflare-c3/*.md",
          {
            "input": "./plugins/nx-cloudflare-c3/src",
            "glob": "**/!(*.ts)",
            "output": "./src"
          },
          {
            "input": "./plugins/nx-cloudflare-c3/src",
            "glob": "**/*.d.ts",
            "output": "./src"
          },
          {
            "input": "./plugins/nx-cloudflare-c3",
            "glob": "generators.json",
            "output": "."
          },
          {
            "input": "./plugins/nx-cloudflare-c3",
            "glob": "executors.json",
            "output": "."
          }
        ]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "plugins/nx-cloudflare-c3/jest.config.cts"
      }
    }
  }
}
